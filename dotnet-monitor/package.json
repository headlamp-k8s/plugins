{
  "name": "headlamp-dotnet-monitor",
  "version": "0.1.8",
  "description": "Headlamp plugin that adds .NET diagnostics actions for dotnet-monitor sidecars.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "headlamp-plugin start",
    "build": "headlamp-plugin build",
    "format": "headlamp-plugin format",
    "lint": "headlamp-plugin lint",
    "lint-fix": "headlamp-plugin lint --fix",
    "package": "headlamp-plugin package . ./artifacts",
    "tsc": "headlamp-plugin tsc",
    "test": "vitest run"
  },
  "keywords": [
    "headlamp",
    "headlamp-plugin",
    "kubernetes",
    "dotnet",
    "dotnet-monitor",
    "diagnostics"
  ],
  "prettier": "@headlamp-k8s/eslint-config/prettier-config",
  "eslintConfig": {
    "extends": [
      "@headlamp-k8s",
      "prettier",
      "plugin:jsx-a11y/recommended"
    ]
  },
  "devDependencies": {
    "@kinvolk/headlamp-plugin": "^0.14.0",
    "@types/node": "^22.15.21",
    "typescript": "^5.6.2",
    "vitest": "^2.1.9"
  }
}
